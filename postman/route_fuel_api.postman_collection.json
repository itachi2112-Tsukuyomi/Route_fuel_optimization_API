            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Map (HTML) - New York to Los Angeles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            "map",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        },
        "description": "Open in a browser for the interactive map."
      }
    }
  ]
}