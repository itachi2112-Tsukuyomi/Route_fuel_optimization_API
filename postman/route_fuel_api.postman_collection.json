{
  "info": {
    "name": "Route Fuel Optimization API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cheapest fuel stops for a US road trip (500 mi range, 10 mpg)."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plan route (GET) - New York to Los Angeles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        },
        "description": "Coast to coast; starts with a full tank."
      }
    },
    {
      "name": "Plan route (POST) - Chicago to Houston",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Houston, TX\"\n}"
        }
      }
    },
    {
      "name": "Plan route - start empty (whole-trip fuel bill)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Seattle, WA&finish=Miami, FL&start_tank=empty",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Seattle, WA"
            },
            {
              "key": "finish",
              "value": "Miami, FL"
            },
            {
              "key": "start_tank",
              "value": "empty"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Plan route - pure cheapest (no stop penalty)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Denver, CO&finish=Atlanta, GA&stop_penalty=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Denver, CO"
            },
            {
              "key": "finish",
              "value": "Atlanta, GA"
            },
            {
              "key": "stop_penalty",
              "value": "0"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Plan route - ZIP code and coordinates",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=10001&finish=34.0522,-118.2437",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "10001"
            },
            {
              "key": "finish",
              "value": "34.0522,-118.2437"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Short trip - no stops needed",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Dallas, TX&finish=Austin, TX",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "Austin, TX"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Error - outside USA",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Toronto, ON&finish=Chicago, IL",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Toronto, ON"
            },
            {
              "key": "finish",
              "value": "Chicago, IL"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Error - missing finish",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
